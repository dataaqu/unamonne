# Neon Postgres connection string (Vercel Marketplace → Neon, or neon.tech).
# Use the pooled connection string; the neon-serverless driver connects over WebSocket.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Local development only — leave unset for Neon and every deployed environment.
# Points the neon-serverless driver at a `neondatabase/wsproxy` container so the
# app can run against a throwaway local Postgres. See docs/db-setup.md.
# NEON_WS_PROXY=localhost:55433/v1

# Auth.js session secret — generate with: npx auth secret
AUTH_SECRET=generate-with-npx-auth-secret

# Admin bootstrap — used by `npm run seed:admin` to create/promote the admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Cloudflare R2 (image storage, S3-compatible) — product image uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vintage-media
R2_PUBLIC_BASE_URL=https://media.example.com

# Cloudflare Images (resize/optimize) + Stream (video)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_HASH=
CLOUDFLARE_STREAM_TOKEN=

# Abandoned-cart cron (T4.3). Vercel Cron sends this as `Authorization: Bearer <secret>`
# to /api/cron/abandoned-carts; the route rejects anything else. Generate a random value.
CRON_SECRET=
